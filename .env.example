# Android emulator → host machine
API_BASE_URL=http://10.0.2.2:8080/api/v1

# iOS simulator
# API_BASE_URL=http://127.0.0.1:8080/api/v1

# Physical device — Mac + phone on THE SAME network (prefer phone hotspot)
#   ./scripts/sync-api-url.sh --write
# Find Mac IP: ipconfig getifaddr en0
# Office Wi‑Fi often blocks phone↔laptop. Prefer: turn on phone hotspot → Mac joins → sync IP → rebuild.
# USB Android fallback: adb reverse tcp:8080 tcp:8080
#   API_BASE_URL=http://127.0.0.1:8080/api/v1
# API_BASE_URL=http://172.20.10.2:8080/api/v1

# Google Maps Platform — place search + traffic ETAs
# Enable: Places API (New), Routes API
# https://console.cloud.google.com/google/maps-apis
# For Flutter HTTP calls, prefer API restriction only (not Android-app-only).
GOOGLE_MAPS_API_KEY=
