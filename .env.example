# Android emulator → host machine
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# iOS simulator / Expo web
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Physical device — Mac + phone on THE SAME network (prefer phone hotspot)
# Find Mac IP: ipconfig getifaddr en0
# EXPO_PUBLIC_API_BASE_URL=http://<your-lan-ip>:8080/api/v1

# Google Maps Platform — optional place search + reverse geocode
# Enable Places API (New) + Geocoding API. Live traffic routes go through the backend.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Chat WebSocket uses the same host as EXPO_PUBLIC_API_BASE_URL (ws://host:port/ws-native).
